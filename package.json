{
  "name": "premiumkits-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev --port 8787 --test-scheduled",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply premiumkits --local",
    "db:migrate:remote": "wrangler d1 migrations apply premiumkits --remote",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "deploy": "npm run build && wrangler d1 migrations apply premiumkits --remote && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  },
  "description": "Bangladeshi football-jersey e-commerce store \u2014 React + Cloudflare Workers + D1, with bKash and SSLCommerz checkout and an admin panel."
}
